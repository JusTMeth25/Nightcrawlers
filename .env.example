# Nightcrawlers stack configuration (/opt/nightcrawlers/.env on the VM, mode 600, never committed).
# On the VM ops/init-secrets.sh (run by ops/setup-vm.sh) writes this file: it generates every
# secret with openssl and adds the production values below. You only fill in the Brevo SMTP
# login/key and the DuckDNS token. Avoid the characters $ and # in values.

# --- Public site
DOMAIN=playnightcrawlers.duckdns.org
# Origin as seen by browsers: CORS whitelist (ALLOWED_ORIGINS) and links in emails (FRONTEND_URL).
PUBLIC_URL=https://playnightcrawlers.duckdns.org
# Let's Encrypt account email.
ACME_EMAIL=you@example.com
# First deploy: the staging CA (untrusted test certificates, generous rate limits).
# Then https://acme-v02.api.letsencrypt.org/directory and `docker compose up -d --force-recreate web`.
ACME_CA=https://acme-staging-v02.api.letsencrypt.org/directory
# acme (default) | internal (local CA, dev only)
CADDY_TLS=acme

# --- Images: ghcr.io/<github.repository in lower case>; TAG is set by the deploy job (commit SHA)
IMAGE_PREFIX=ghcr.io/justmeth25/nightcrawlers
TAG=

# --- Database: superuser (init and backups), Flyway owner and DML-only runtime roles,
# created on the first start of an empty volume. Passwords: generated, openssl rand -hex 24
POSTGRES_DB=nightcrawlers
POSTGRES_PASSWORD=CHANGE_ME
DB_OWNER_USER=nc_owner
DB_OWNER_PASSWORD=CHANGE_ME
DB_APP_USER=nc_app
DB_APP_PASSWORD=CHANGE_ME

# --- Backend secrets: generated (at least 32 random bytes; values starting with CHANGE_ME stop the backend)
JWT_SECRET=CHANGE_ME
IP_HASH_SALT=CHANGE_ME

# --- Mail: Brevo SMTP relay, STARTTLS on 587; MAIL_FROM is the verified Brevo sender
SMTP_HOST=smtp-relay.brevo.com
SMTP_PORT=587
SMTP_USERNAME=CHANGE_ME
SMTP_PASSWORD=CHANGE_ME
MAIL_FROM=Nightcrawlers <you@example.com>

# --- DuckDNS (subdomain without .duckdns.org)
DUCKDNS_SUBDOMAIN=playnightcrawlers
DUCKDNS_TOKEN=CHANGE_ME

# --- Optional
TZ=Europe/Rome
# HTTP_PORT=80
# HTTPS_PORT=443
