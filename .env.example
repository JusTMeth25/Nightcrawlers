# Nightcrawlers stack configuration. Copy to .env (chmod 600) and fill in every CHANGE_ME.
# Never commit .env. Generate secrets with: openssl rand -base64 48 | tr -d '\n'
# Avoid the characters $ and # in values (compose interpolation / comments).

# --- Public site
DOMAIN=CHANGE_ME.duckdns.org
# Origin of the site as seen by browsers (CORS whitelist and links in emails).
PUBLIC_URL=https://CHANGE_ME.duckdns.org
# Let's Encrypt account email (expiry notices).
ACME_EMAIL=CHANGE_ME@example.org
# First deploy: the staging CA (untrusted test certificates, generous rate limits).
# Then switch to https://acme-v02.api.letsencrypt.org/directory and restart web.
ACME_CA=https://acme-staging-v02.api.letsencrypt.org/directory
# acme (default) | internal (local CA, dev only)
CADDY_TLS=acme

# --- Images (set by the deploy job; lower-case GitHub owner)
GHCR_OWNER=CHANGE_ME
TAG=latest

# --- Database (superuser used only by the container's init and backups)
POSTGRES_DB=nightcrawlers
POSTGRES_PASSWORD=CHANGE_ME
# Flyway (schema owner) and runtime (DML only) roles, created on the first start.
DB_OWNER_USER=nc_owner
DB_OWNER_PASSWORD=CHANGE_ME
DB_APP_USER=nc_app
DB_APP_PASSWORD=CHANGE_ME

# --- Backend secrets (at least 32 random bytes; values starting with CHANGE_ME stop the backend)
JWT_SECRET=CHANGE_ME
IP_HASH_SALT=CHANGE_ME

# --- Mail (Brevo SMTP relay)
SMTP_HOST=smtp-relay.brevo.com
SMTP_PORT=587
SMTP_USERNAME=CHANGE_ME
SMTP_PASSWORD=CHANGE_ME
MAIL_FROM=Nightcrawlers <no-reply@CHANGE_ME.example.org>

# --- DuckDNS (subdomain without .duckdns.org)
DUCKDNS_SUBDOMAIN=CHANGE_ME
DUCKDNS_TOKEN=CHANGE_ME

# --- Optional
# TZ=Europe/Rome
# HTTP_PORT=80
# HTTPS_PORT=443
